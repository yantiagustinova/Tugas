# ─── Database (wajib) ──────────────────────────────────────────────────────
# Connection string PostgreSQL. Cocok untuk Neon / Vercel Postgres / Supabase.
# Contoh Neon:
# DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/envilog?sslmode=require"
DATABASE_URL=""

# ─── Sesi login (wajib) ────────────────────────────────────────────────────
# Minimal 16 karakter, acak. Buat dengan: openssl rand -base64 32
SESSION_SECRET=""

# ─── Aplikasi ──────────────────────────────────────────────────────────────
# Dipakai sebagai link di pesan WhatsApp.
APP_URL="https://task-tracker-envilog.vercel.app"
# Zona waktu tim (default Asia/Jakarta).
APP_TIMEZONE="Asia/Jakarta"

# ─── Pengingat WhatsApp ────────────────────────────────────────────────────
# Mulai mengingatkan H-2 sebelum due date.
REMINDER_LEAD_DAYS="2"
# Token rahasia untuk endpoint cron. Vercel Cron otomatis mengirim
# header "Authorization: Bearer <CRON_SECRET>" kalau env ini di-set.
CRON_SECRET=""

# Gateway WA: "fonnte" | "wablas" | "log"
# "log" (default) = tidak mengirim apa pun, hanya menulis pesan ke server log.
WA_PROVIDER="log"

# ID grup WhatsApp tujuan rekap harian.
# Fonnte : ID grup (mis. "1203630xxxxxxxxx@g.us")
# Wablas : group_id dari dashboard Wablas
WA_GROUP_ID=""

# Kalau WA_PROVIDER="fonnte"
FONNTE_TOKEN=""

# Kalau WA_PROVIDER="wablas"
WABLAS_TOKEN=""
WABLAS_DOMAIN="https://console.wablas.com"
